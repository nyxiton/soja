<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_soja_app_page" name="SoSoja Website App">
        <t t-call="website.layout">
            <div id="wrap" class="o_soja_website_wrap">
                <link rel="stylesheet" t-att-href="'/soja_management/static/src/css/soja_app.css?v=%s' % asset_version"/>
                <div id="soja-app" t-att-data-asset-version="asset_version"></div>
                <script t-att-src="'/soja_management/static/src/js/soja_app.js?v=%s' % asset_version"></script>
            </div>
        </t>
    </template>

    <record id="website_menu_soja" model="website.menu">
        <field name="name">SoSoja</field>
        <field name="url">/soja</field>
        <field name="sequence">20</field>
    </record>
</odoo>
