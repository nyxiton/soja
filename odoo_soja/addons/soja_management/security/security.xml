<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_soja" model="ir.module.category">
        <field name="name">SOJA</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_soja_producer" model="res.groups">
        <field name="name">Producteur</field>
        <field name="category_id" ref="module_category_soja"/>
    </record>

    <record id="group_soja_cooperative" model="res.groups">
        <field name="name">Cooperative</field>
        <field name="category_id" ref="module_category_soja"/>
    </record>

    <record id="group_soja_factory" model="res.groups">
        <field name="name">Usine</field>
        <field name="category_id" ref="module_category_soja"/>
    </record>

    <record id="group_soja_bank" model="res.groups">
        <field name="name">Banque</field>
        <field name="category_id" ref="module_category_soja"/>
    </record>

    <record id="group_soja_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="category_id" ref="module_category_soja"/>
        <field name="implied_ids" eval="[(4, ref('group_soja_producer')), (4, ref('group_soja_cooperative')), (4, ref('group_soja_factory')), (4, ref('group_soja_bank'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_soja_manager'))]"/>
    </record>

    <record id="rule_soja_partner_read_all" model="ir.rule">
        <field name="name">SOJA contacts producteurs lisibles par tous les rôles</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('is_soja_producer', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_soja_manager')), (4, ref('group_soja_producer')), (4, ref('group_soja_cooperative')), (4, ref('group_soja_factory')), (4, ref('group_soja_bank'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_soja_harvest_read_all" model="ir.rule">
        <field name="name">SOJA récoltes lisibles par tous les rôles</field>
        <field name="model_id" ref="model_soja_harvest"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_soja_manager')), (4, ref('group_soja_producer')), (4, ref('group_soja_cooperative')), (4, ref('group_soja_factory')), (4, ref('group_soja_bank'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_soja_plot_point_read_all" model="ir.rule">
        <field name="name">SOJA points GPS lisibles par tous les rôles</field>
        <field name="model_id" ref="model_soja_plot_point"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_soja_manager')), (4, ref('group_soja_producer')), (4, ref('group_soja_cooperative')), (4, ref('group_soja_factory')), (4, ref('group_soja_bank'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_soja_partner_manager_all" model="ir.rule">
        <field name="name">SOJA gestionnaire gère tous les contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_soja_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_soja_harvest_manager_all" model="ir.rule">
        <field name="name">SOJA gestionnaire gère toutes les récoltes</field>
        <field name="model_id" ref="model_soja_harvest"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_soja_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_soja_plot_point_manager_all" model="ir.rule">
        <field name="name">SOJA gestionnaire gère tous les points GPS</field>
        <field name="model_id" ref="model_soja_plot_point"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_soja_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_soja_partner_owner_write" model="ir.rule">
        <field name="name">SOJA producteur modifie son contact producteur</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('is_soja_producer', '=', True), ('soja_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_soja_producer'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_soja_harvest_owner_write" model="ir.rule">
        <field name="name">SOJA producteur modifie ses récoltes</field>
        <field name="model_id" ref="model_soja_harvest"/>
        <field name="domain_force">[('partner_id.soja_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_soja_producer'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_soja_plot_point_owner_write" model="ir.rule">
        <field name="name">SOJA producteur modifie ses points GPS</field>
        <field name="model_id" ref="model_soja_plot_point"/>
        <field name="domain_force">[('partner_id.soja_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_soja_producer'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_soja_harvest_cooperative_write" model="ir.rule">
        <field name="name">SOJA coopérative modifie le stockage partagé</field>
        <field name="model_id" ref="model_soja_harvest"/>
        <field name="domain_force">[('share_status', 'in', ['partners', 'cooperative'])]</field>
        <field name="groups" eval="[(4, ref('group_soja_cooperative'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_soja_harvest_factory_write" model="ir.rule">
        <field name="name">SOJA usine modifie le traitement partagé</field>
        <field name="model_id" ref="model_soja_harvest"/>
        <field name="domain_force">[('share_status', 'in', ['partners', 'factory'])]</field>
        <field name="groups" eval="[(4, ref('group_soja_factory'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_soja_harvest_bank_write" model="ir.rule">
        <field name="name">SOJA banque modifie le dossier partagé</field>
        <field name="model_id" ref="model_soja_harvest"/>
        <field name="domain_force">[('share_status', 'in', ['partners', 'bank'])]</field>
        <field name="groups" eval="[(4, ref('group_soja_bank'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
