POSTGRES_DB=soja
POSTGRES_USER=soja
POSTGRES_PASSWORD=local-soja-password
POSTGRES_HOST=host.docker.internal
POSTGRES_PUBLIC_PORT=5433

DJANGO_SECRET_KEY=local-dev-secret-key-change-before-real-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

BACKEND_PUBLIC_PORT=8000
FRONTEND_PUBLIC_PORT=8080
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=info
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
